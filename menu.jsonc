  "setup.clipboard-shelf": {
    "icon": "󰅌",
    "label": "Clipboard shelf",
    "aliases": ["clipboard", "clip", "paste", "snippets", "pin", "history"]
  },
  "setup.clipboard-shelf.open": {
    "icon": "󰅌",
    "label": "Open the shelf",
    "action": "omarchy-shell shell toggle reidenxerx.clipboard-shelf '{}'"
  },
  "setup.clipboard-shelf.pin": {
    "icon": "󰐃",
    "label": "Pin what is on the clipboard",
    "action": "/usr/bin/python3 @PLUGIN_BIN@/clip-shelf pin --clipboard"
  },
  "setup.clipboard-shelf.list": {
    "icon": "󰋽",
    "label": "Show pinned snippets",
    "action": "omarchy-launch-floating-terminal-with-presentation /usr/bin/python3 @PLUGIN_BIN@/clip-shelf list"
  },
  "setup.clipboard-shelf.clear": {
    "icon": "󰅖",
    "label": "Clear all pins",
    "action": "/usr/bin/python3 @PLUGIN_BIN@/clip-shelf clear"
  },
